# Server Configuration
PORT=3000
NODE_ENV=development

# AWS Configuration (Required for Public Cloud Hosting)
# Note: When deploying to an AWS EC2 instance with an attached IAM Role,
# AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY can be left blank because
# AWS SDK automatically retrieves temporary credentials via the EC2 Instance Metadata Service (IMDSv2).
AWS_REGION=us-east-1
AWS_BUCKET_NAME=your-ats-resume-bucket-name

# Optional Static AWS Credentials (Used for local testing or IAM user authentication)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
